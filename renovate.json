{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Repository-specific Renovate config. Extends the shared bcgov/renovate-config preset. Downstream repos should reference this file for consistent update management.",
  "extends": [
    "github>bcgov/renovate-config"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Group Vue 2 and Vuetify 2 dependencies",
      "matchPackageNames": [
        "vue",
        "vue-template-compiler",
        "vue-router",
        "vuex",
        "vue-class-component",
        "vue-property-decorator",
        "vuex-class",
        "vuex-module-decorators",
        "vuetify",
        "vue-cli-plugin-vuetify"
      ],
      "groupName": "Vue 2 / Vuetify 2"
    },
    {
      "description": "Prevent accidental Vuetify 3 migration",
      "matchPackageNames": [
        "vuetify"
      ],
      "allowedVersions": "<3"
    }
  ]
}
