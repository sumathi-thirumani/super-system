{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Repository-specific Renovate config. Extends the shared bcgov/renovate-config preset. Downstream repos should reference this file for consistent update management.",
  "extends": [
    "github>bcgov/renovate-config"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Group Vue and Vuetify upgrades",
      "matchPackageNames": [
        "vue",
        "vuetify",
        "vue-template-compiler",
        "vue-router",
        "vuex",
        "vue-class-component",
        "vue-property-decorator",
        "vuex-class",
        "vuex-module-decorators",
        "vue-cli-plugin-vuetify"
      ],
      "groupName": "Vue / Vuetify"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "packageRules": [
      {
        "description": "Group Vue and Vuetify security updates",
        "matchPackageNames": [
          "vue",
          "vuetify",
          "vue-template-compiler",
          "vue-router",
          "vuex",
          "vue-class-component",
          "vue-property-decorator",
          "vuex-class",
          "vuex-module-decorators",
          "vue-cli-plugin-vuetify"
        ],
        "groupName": "Vue / Vuetify security"
      }
    ]
  }
}
